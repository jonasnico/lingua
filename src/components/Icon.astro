---
type Name = 'sound' | 'previous' | 'next' | 'more' | 'expand';

interface Props {
	name: Name;
}

const paths: Record<Name, string> = {
	sound: 'M11 5 6 9H3v6h3l5 4V5Zm4 3a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14',
	previous: 'm14 6-6 6 6 6',
	next: 'm10 6 6 6-6 6',
	more: 'M5 12h.01M12 12h.01M19 12h.01',
	expand: 'm8 10 4 4 4-4',
};
---

<svg
	width="20"
	height="20"
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.6"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
>
	<path d={paths[Astro.props.name]} />
</svg>
