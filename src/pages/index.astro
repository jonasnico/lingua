---
import Icon from '../components/Icon.astro';
import { formatDisplayDate } from '../data/languages';
import { getAdjacentPublishedDay, resolveDailySelection } from '../data/dailySelection';
import '../styles/global.css';

const { dateKey, snippet, message } = resolveDailySelection(new URLSearchParams());
const previousDay = getAdjacentPublishedDay(dateKey, -1);
const nextDay = getAdjacentPublishedDay(dateKey, 1);
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#f6f7f9" />
		<meta
			name="description"
			content="A little Spanish, every day. Discover one phrase at a time."
		/>
		<title>Lingua — a little Spanish, every day</title>
	</head>
	<body>
		<a class="skip-link" href="#daily-phrase">Skip to phrase</a>
		<div class="page-shell">
			<header class="site-header">
				<a class="brand" href={baseUrl} aria-label="Lingua home">Lingua</a>
				<div class="header-actions">
					<span class="language-label">Spanish</span>
					<details class="options" data-options>
						<summary class="icon-button" aria-label="More options" title="More options">
							<Icon name="more" />
						</summary>
						<div class="options-panel">
							<label class="practice-option">
								<span>Practice mode</span>
								<input type="checkbox" data-snippet-recall checked />
							</label>
							<a
								class="menu-link"
								href={`?day=${dateKey}&phrase=${snippet.id}`}
								data-snippet-permalink
							>Copy phrase link</a>
						</div>
					</details>
				</div>
			</header>

			<main>
				<article class="lesson" aria-labelledby="daily-phrase">
					<time class="lesson-date" datetime={dateKey} data-snippet-date>
						{formatDisplayDate(dateKey)}
					</time>
					<h1 id="daily-phrase" class="phrase" lang="es" data-snippet-phrase>{snippet.phrase}</h1>

					<div class="meaning-stage">
						<button
							class="meaning-toggle"
							type="button"
							aria-expanded="false"
							aria-controls="phrase-translation phrase-context example-translation"
							data-snippet-reveal
							hidden
						>
							<span data-reveal-label>Show meaning</span>
							<span id="phrase-translation" data-snippet-translation hidden>{snippet.translation}</span>
						</button>
						<noscript><p class="translation">{snippet.translation}</p></noscript>
					</div>

					<div class="audio-control" data-audio-control hidden>
						<button
							class="text-button listen-button"
							type="button"
							aria-pressed="false"
							data-snippet-listen
						>
							<Icon name="sound" />
							<span data-listen-label>Listen</span>
						</button>
					</div>

					<details class="explore" data-explore>
						<summary class="text-button">
							<span>Explore</span>
							<Icon name="expand" />
						</summary>
						<div class="explore-content">
							<section class="note">
								<h2>Pronunciation</h2>
								<p data-snippet-pronunciation>{snippet.pronunciation}</p>
								<p class="region" data-snippet-region hidden={!snippet.region}>{snippet.region}</p>
							</section>
							<section class="note">
								<h2>In a sentence</h2>
								<p lang="es" data-snippet-example-original>{snippet.example.original}</p>
								<p class="example-translation" id="example-translation" data-snippet-example-translation>
									{snippet.example.translation}
								</p>
							</section>
							<section class="note" id="phrase-context" data-snippet-context>
								<h2>A little context</h2>
								<p data-snippet-cultural-note>{snippet.culturalNote}</p>
							</section>
							<p class="recording-credit" data-audio-help></p>
						</div>
					</details>

					<p class="interaction-status" data-snippet-status aria-live="polite" aria-atomic="true">{message}</p>
					<p class="sr-only" data-snippet-announcement aria-live="polite" aria-atomic="true"></p>
					<noscript><p class="interaction-status">Enable JavaScript to browse and practice.</p></noscript>
				</article>
			</main>

			<footer>
				<nav class="day-navigation" aria-label="Phrase navigation">
					<a
						class="text-button"
						href={previousDay ? `?day=${previousDay}` : undefined}
						aria-disabled={previousDay ? undefined : 'true'}
						data-snippet-previous
					><Icon name="previous" /><span>Previous</span></a>
					<button class="text-button today-button" type="button" data-snippet-today>Today</button>
					<a
						class="text-button"
						href={nextDay ? `?day=${nextDay}` : undefined}
						aria-disabled={nextDay ? undefined : 'true'}
						data-snippet-next
					><span>Next</span><Icon name="next" /></a>
				</nav>
			</footer>
		</div>
		<script>
			import '../scripts/dailySnippet';
		</script>
	</body>
</html>
